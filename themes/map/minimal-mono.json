{
  "id": "minimal-mono",
  "name": "Minimal Mono",
  "description": "Grayscale diagrams for wayfinding and academic maps — zero chroma.",
  "notes": "Pure grayscale ramp. Every line weight/station still reads. Pair with dashed vs double styles to distinguish lines without colour.",
