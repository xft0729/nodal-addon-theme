    "labelColor": "#000000",
    "fontWeight": 400,
    "fontStyle": "normal",
    "textTransform": "uppercase",
    "letterSpacing": 1.2
  },
  "linePalette": [
    "#000000",
    "#333333",
    "#555555",
    "#777777",
    "#999999",
    "#BBBBBB",
    "#444444",
    "#222222"
  ],
  "lineStyle": "preserve",
  "tags": [
    "mono",
    "minimal",
    "grayscale",
    "wayfinding"
  ]
}
